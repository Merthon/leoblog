---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WritingRow from '../../components/content/WritingRow.astro';
import { getPublishedWriting } from '../../lib/content';

const entries = await getPublishedWriting();
---

<BaseLayout title="文章" description="记录技术决策，也记录那些还没有标准答案的问题。" active="writing">
  <div class="page-content">
    <h1 class="page-title">文章</h1>
    <p class="page-description">记录技术决策，也记录那些还没有标准答案的问题。</p>
    <div class="filters" role="group" aria-label="筛选文章类型">
      <button class="active" type="button" data-filter="all">全部</button>
      <button type="button" data-filter="technical">技术</button>
      <button type="button" data-filter="thinking">思考</button>
      <button type="button" data-filter="essay">随笔</button>
    </div>
    <div class="archive">
      <div class="year-heading mono">2026</div>
      <div class="writing-list">
        {entries.map((entry, index) => (
          <div data-entry-type={entry.data.type}><WritingRow entry={entry} isNew={index === 0} /></div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const entries = [...document.querySelectorAll<HTMLElement>('[data-entry-type]')];
  const allowedFilters = new Set(['all', 'technical', 'thinking', 'essay']);

  function applyFilter(filter: string, updateUrl = true) {
    const resolved = allowedFilters.has(filter) ? filter : 'all';
    buttons.forEach((item) => item.classList.toggle('active', item.dataset.filter === resolved));
    entries.forEach((entry) => { entry.hidden = resolved !== 'all' && entry.dataset.entryType !== resolved; });

    if (updateUrl) {
      const url = new URL(window.location.href);
      if (resolved === 'all') url.searchParams.delete('type');
      else url.searchParams.set('type', resolved);
      history.replaceState(null, '', url);
    }
  }

  applyFilter(new URL(window.location.href).searchParams.get('type') ?? 'all', false);
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      applyFilter(button.dataset.filter ?? 'all');
    });
  });
</script>

<style>
  .filters { display: flex; gap: 2.5rem; border-bottom: 1px solid var(--color-line); }
  button { position: relative; padding: 0.75rem 0 1rem; background: transparent; color: var(--color-muted); cursor: pointer; }
  button::after { content: ""; position: absolute; right: 0; bottom: -1px; left: 0; height: 2px; background: transparent; }
  button:hover, button.active { color: var(--color-accent); }
  button.active::after { background: var(--color-accent); }
  .archive { display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: 1.5rem; margin-top: 2rem; }
  .year-heading { padding-top: 2.35rem; color: var(--color-muted); }
  [hidden] { display: none; }
  @media (max-width: 900px) {
    .filters { justify-content: space-between; gap: 1.25rem; overflow-x: auto; }
    .archive { display: block; margin-top: 0; }
    .year-heading { padding: 2rem 0 0.5rem; }
  }
</style>
