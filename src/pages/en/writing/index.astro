---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WritingRow from '../../../components/content/WritingRow.astro';
import { getPublishedWritingEn } from '../../../lib/content';

const entries = await getPublishedWritingEn();
const yearGroups = entries.reduce<Array<{ year: number; entries: typeof entries }>>((groups, entry) => {
  const year = entry.data.publishedAt.getFullYear();
  const current = groups.at(-1);
  if (current?.year === year) current.entries.push(entry);
  else groups.push({ year, entries: [entry] });
  return groups;
}, []);
---

<BaseLayout title="Writing" description="Technical decisions, open questions, and notes from building." active="writing" locale="en" languageHref="/writing/" alternatePath="/writing/">
  <div class="page-content">
    <h1 class="page-title">Writing</h1>
    <p class="page-description">Technical decisions, open questions, and notes from building.</p>
    <p class="edition-note" id="translation-note">The English edition is curated. Some older notes are currently available only in Chinese.</p>
    <div class="filters" role="group" aria-label="Filter articles by type">
      <button class="active" type="button" data-filter="all">All</button>
      <button type="button" data-filter="technical">Technical</button>
      <button type="button" data-filter="thinking">Thinking</button>
      <button type="button" data-filter="essay">Essays</button>
    </div>
    <div class="archives">
      {yearGroups.map((group) => (
        <section class="archive" aria-labelledby={`year-${group.year}`}>
          <h2 class="year-heading mono" id={`year-${group.year}`}>{group.year}</h2>
          <div class="writing-list">{group.entries.map((entry) => <div data-entry-type={entry.data.type}><WritingRow entry={entry} isNew={entry.id === entries[0]?.id} locale="en" /></div>)}</div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const entries = [...document.querySelectorAll<HTMLElement>('[data-entry-type]')];
  const allowedFilters = new Set(['all', 'technical', 'thinking', 'essay']);
  function applyFilter(filter: string, updateUrl = true) {
    const resolved = allowedFilters.has(filter) ? filter : 'all';
    buttons.forEach((item) => item.classList.toggle('active', item.dataset.filter === resolved));
    entries.forEach((entry) => { entry.hidden = resolved !== 'all' && entry.dataset.entryType !== resolved; });
    if (updateUrl) {
      const url = new URL(window.location.href);
      if (resolved === 'all') url.searchParams.delete('type'); else url.searchParams.set('type', resolved);
      history.replaceState(null, '', url);
    }
  }
  applyFilter(new URL(window.location.href).searchParams.get('type') ?? 'all', false);
  buttons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'all')));
</script>

<style>
  .edition-note { max-width: 42rem; padding-left: 0.85rem; margin: calc(-1 * var(--space-6)) 0 var(--space-8); border-left: 2px solid var(--color-accent); color: var(--color-muted); font-size: 0.82rem; }
  .filters { display: flex; gap: 2.5rem; border-bottom: 1px solid var(--color-line); }
  button { position: relative; padding: 0.75rem 0 1rem; background: transparent; color: var(--color-muted); cursor: pointer; }
  button::after { content: ""; position: absolute; right: 0; bottom: -1px; left: 0; height: 2px; background: transparent; }
  button:hover, button.active { color: var(--color-accent); }
  button.active::after { background: var(--color-accent); }
  .archives { margin-top: 2rem; }
  .archive { display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: 1.5rem; }
  .archive + .archive { margin-top: 2rem; }
  .year-heading { padding-top: 2.35rem; margin: 0; color: var(--color-muted); font-size: 0.85rem; font-weight: 400; }
  [hidden] { display: none; }
  @media (max-width: 900px) {
    .edition-note { margin-top: calc(-1 * var(--space-4)); }
    .filters { justify-content: space-between; gap: 1.25rem; overflow-x: auto; }
    .archives { margin-top: 0; }
    .archive { display: block; }
    .archive + .archive { margin-top: 1rem; }
    .year-heading { padding: 2rem 0 0.5rem; }
  }
</style>
