---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectRow from '../../../components/content/ProjectRow.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import { getProjectsEn } from '../../../lib/content';
import { SITE_EN } from '../../../config/site';

const projects = await getProjectsEn();
const featured = projects.find((entry) => entry.data.featured) ?? projects[0];
---

<BaseLayout title="Projects" description="Turning ideas into things that can run and be tested." active="projects" locale="en" languageHref="/projects/" alternatePath="/projects/">
  <div class="page-content">
    <h1 class="page-title">Projects</h1>
    <p class="page-description">Turning ideas into things that can run and be tested.</p>
    <section class="featured-project">
      <span class="project-state">{SITE_EN.project.status}</span>
      <h2><a href={`/en/projects/${featured.id}/`}>{featured.data.title}</a></h2>
      <div class="project-facts">
        <div><h3>Problem</h3><p>{featured.data.problem}</p><p class="stack mono">{featured.data.stack.join(' / ')}</p></div>
        <div><h3>Key decisions</h3><ul>{featured.data.decisions.map((decision) => <li>{decision}</li>)}</ul></div>
        <div><h3>Current state</h3><p>Continuing to refine the content and reading experience.</p></div>
      </div>
    </section>
    <section class="projects-index">
      <SectionHeading title="Project index" />
      <div class="column-headings" aria-hidden="true"><span>Project</span><span>Problem</span><span>Stack</span><span>Status</span><span>Updated</span><span></span></div>
      <div class="project-list">{projects.map((entry) => <ProjectRow entry={entry} locale="en" />)}</div>
    </section>
  </div>
</BaseLayout>

<style>
  :global(.page-title)::after { content: ""; display: block; width: 2rem; height: 2px; margin-top: 1rem; background: var(--color-accent); }
  .featured-project { padding: 2rem 0 2.5rem; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }
  .project-state { color: var(--color-accent); font-size: 0.82rem; }
  .featured-project > h2 { margin: 0.75rem 0 0; font-family: var(--font-display); font-size: 2.3rem; letter-spacing: -0.025em; }
  .stack { margin-top: 1.75rem !important; color: var(--color-muted) !important; font-size: 0.82rem !important; }
  .project-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; padding: 1.5rem 0; }
  .project-facts h3 { margin: 0 0 0.65rem; font-size: 0.88rem; }
  .project-facts p { margin: 0; color: var(--color-body); font-size: 0.88rem; }
  .project-facts ul { display: grid; gap: 0.55rem; padding: 0; margin: 0; list-style: none; }
  .project-facts li { position: relative; padding-left: 1.15rem; color: var(--color-body); font-size: 0.88rem; }
  .project-facts li::before { content: ""; position: absolute; top: 0.7em; left: 0; width: 0.35rem; height: 0.35rem; border-radius: 50%; background: var(--color-muted); }
  .projects-index { padding-top: 2.5rem; }
  .column-headings { display: grid; grid-template-columns: minmax(9rem, 0.9fr) minmax(13rem, 1.45fr) minmax(12rem, 1.1fr) 6rem 6.5rem 1.25rem; gap: 1rem; padding-bottom: 0.65rem; border-bottom: 1px solid var(--color-line); color: var(--color-muted); font-size: 0.75rem; }
  @media (max-width: 1300px) { .column-headings { display: none; } }
  @media (max-width: 900px) {
    .project-facts { display: block; padding: 1rem 0; }
    .project-facts div { padding: 1rem 0; border-bottom: 1px solid var(--color-line); }
  }
</style>
