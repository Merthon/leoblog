---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DISPLAY_UPDATED_AT, SITE, SITE_EN } from '../../config/site';
---

<BaseLayout title="Now" description={`What ${SITE.displayName} is working on and thinking about now.`} active="now" locale="en" languageHref="/now/" alternatePath="/now/">
  <div class="page-content now-page">
    <header class="now-header">
      <div>
        <h1 class="page-title">Now</h1>
        <p class="updated mono">Updated {DISPLAY_UPDATED_AT}</p>
      </div>
      <figure class="portrait-stamp">
        <div class="portrait-frame">
          <img
            src="/images/leo-288.webp"
            srcset="/images/leo-176.webp 176w, /images/leo-288.webp 288w"
            sizes="(max-width: 900px) 88px, 144px"
            alt={`Portrait of ${SITE.displayName}`}
            width="144"
            height="144"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <figcaption>{SITE.logoText} / DEVELOPER</figcaption>
      </figure>
    </header>
    <div class="now-grid">
      <section class="intro">
        <h2>Hello, I’m {SITE.displayName}, a {SITE_EN.role}.</h2>
        <p>{SITE_EN.intro}</p>
        <div class="subsection"><h3>Current focus</h3><ul>{SITE_EN.now.focuses.map((item) => <li>{item}</li>)}</ul></div>
      </section>
      <section class="current">
        <div><h3>Working on</h3><ul>{SITE_EN.now.doing.map((item, index) => <li class:list={{ active: index === 0 }}>{item}</li>)}</ul></div>
        {SITE_EN.now.reading.length > 0 && <div><h3>Reading</h3><ul>{SITE_EN.now.reading.map((item) => <li>{item}</li>)}</ul></div>}
        <div><h3>Next</h3><ul>{SITE_EN.now.plans.map((item) => <li>{item}</li>)}</ul></div>
      </section>
    </div>
    <div class="about-grid">
      <section>
        <h3>About this site</h3>
        <p>{SITE_EN.now.aboutSite}</p>
        <div class="principles"><h3>Principles</h3><ul>{SITE_EN.now.principles.map((item) => <li>{item}</li>)}</ul></div>
      </section>
      <section class="contact">
        <h3>Contact</h3>
        <dl>
          <dt>Email</dt><dd><a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a></dd>
          <dt>GitHub</dt><dd><a href={SITE.contact.githubUrl}>github.com/{SITE.contact.githubUsername}</a></dd>
          <dt>{SITE.contact.extraLink.label}</dt><dd><a href={SITE.contact.extraLink.url}>{SITE.contact.extraLink.url.replace('https://', '')}</a></dd>
          <dt>RSS</dt><dd><a href="/en/rss.xml">/en/rss.xml</a></dd>
        </dl>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .now-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; padding-bottom: 2rem; }
  .updated { margin: 0; color: var(--color-muted); }
  .portrait-stamp { width: clamp(7.5rem, 9vw, 9rem); flex: 0 0 auto; margin: 0; }
  .portrait-frame { position: relative; overflow: hidden; aspect-ratio: 1; border: 1px solid var(--color-line); background: var(--color-sidebar); }
  .portrait-frame::after { content: ""; position: absolute; right: 0; bottom: 0; left: 0; height: 2px; background: linear-gradient(90deg, var(--color-accent) 0 32%, transparent 32%); }
  .portrait-frame :global(img) { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.82) contrast(1.02); }
  figcaption { margin-top: 0.55rem; color: var(--color-muted); font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.04em; white-space: nowrap; }
  .now-grid, .about-grid { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--color-line); }
  .now-grid > section, .about-grid > section { padding: 2.25rem 3rem 2.25rem 0; }
  .now-grid > section + section, .about-grid > section + section { padding-left: 3rem; border-left: 1px solid var(--color-line); }
  h2, h3 { font-family: var(--font-display); }
  h2 { font-size: 1.3rem; }
  h3 { margin: 0 0 0.8rem; font-size: 1.05rem; }
  p { color: var(--color-body); }
  .subsection, .principles, .current > div + div { padding-top: 1.6rem; margin-top: 1.6rem; border-top: 1px solid var(--color-line); }
  ul { display: grid; gap: 0.6rem; padding: 0; margin: 0; list-style: none; }
  li { position: relative; padding-left: 1.25rem; }
  li::before { content: ""; position: absolute; top: 0.75em; left: 0; width: 0.38rem; height: 0.38rem; border-radius: 50%; background: var(--color-soft); }
  li.active::before { background: var(--color-accent); }
  dl { display: grid; grid-template-columns: 5rem 1fr; gap: 0.65rem 1rem; margin: 0; font-family: var(--font-mono); font-size: 0.85rem; }
  dt { color: var(--color-muted); }
  dd { margin: 0; overflow-wrap: anywhere; }
  @media (max-width: 900px) {
    .now-header { align-items: center; gap: 1rem; padding-bottom: 1.5rem; }
    .portrait-stamp { width: 5.5rem; }
    figcaption { margin-top: 0.4rem; font-size: 0.56rem; }
    .now-grid, .about-grid { display: block; }
    .now-grid > section, .about-grid > section, .now-grid > section + section, .about-grid > section + section { padding: 1.75rem 0; border-left: 0; }
    .now-grid > section + section, .about-grid > section + section { border-top: 1px solid var(--color-line); }
  }
</style>
