---
interface Props {
  title: string;
  accent?: boolean;
}

const { title, accent = false } = Astro.props;
---

<div class:list={['section-heading', { accent }]}>
  <h2>{title}</h2>
  {accent && <span aria-hidden="true"></span>}
</div>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    margin-bottom: var(--space-6);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .accent h2 {
    color: var(--color-accent);
  }

  span {
    width: 2rem;
    height: 2px;
    background: var(--color-accent);
  }
</style>
