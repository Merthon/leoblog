---
import { SITE } from '../../config/site';
import type { SiteLocale } from '../../i18n/ui';

interface Props { locale?: SiteLocale }
const { locale = 'zh-CN' } = Astro.props;
const rssHref = locale === 'en' ? '/en/rss.xml' : '/rss.xml';
---

<footer class="mobile-footer">
  <a href={`mailto:${SITE.contact.email}`}>Email</a>
  <a href={SITE.contact.githubUrl}>GitHub</a>
  <a href={SITE.contact.extraLink.url}>{SITE.contact.extraLink.label}</a>
  <a href={rssHref}>RSS</a>
</footer>

<style>
  .mobile-footer {
    display: none;
  }

  @media (max-width: 900px) {
    .mobile-footer {
      display: flex;
      justify-content: space-between;
      padding: 1.35rem 1.25rem;
      border-top: 1px solid var(--color-line);
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.82rem;
    }
  }
</style>
