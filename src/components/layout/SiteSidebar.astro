---
import Icon from '../ui/Icon.astro';
import { CURRENT_STATUS, CURRENT_STATUS_EN, DISPLAY_UPDATED_AT, SITE, SITE_EN } from '../../config/site';
import { layoutText, navigation, type SiteLocale } from '../../i18n/ui';

interface Props {
  active: 'index' | 'writing' | 'reading' | 'projects' | 'now';
  locale?: SiteLocale;
  languageHref: string;
}

const { active, locale = 'zh-CN', languageHref } = Astro.props;
const isEnglish = locale === 'en';
const nav = navigation[locale];
const text = layoutText[locale];
const status = isEnglish ? CURRENT_STATUS_EN : CURRENT_STATUS;
const homeHref = isEnglish ? '/en/' : '/';
const tagline = isEnglish ? SITE_EN.tagline : SITE.tagline;
const rssHref = isEnglish ? '/en/rss.xml' : '/rss.xml';
---

<aside class="sidebar">
  <div>
    <div class="identity-block">
      <a class="identity" href={homeHref} aria-label={`${SITE.displayName} ${text.homeLabel}`}>
        <strong>{SITE.logoText}</strong>
        <span>{tagline}</span>
      </a>
      <nav class="language-switch" aria-label="Language">
        {isEnglish ? <a href={languageHref} hreflang="zh-CN">中文</a> : <span aria-current="true">中文</span>}
        <i aria-hidden="true">/</i>
        {isEnglish ? <span aria-current="true">EN</span> : <a href={languageHref} hreflang="en">EN</a>}
      </nav>
    </div>

    <nav class="primary-nav" aria-label={text.navLabel}>
      {nav.map((item) => (
        <a class:list={['nav-link', { active: active === item.id }]} href={item.href} aria-current={active === item.id ? 'page' : undefined}>
          <Icon name={item.icon} size={19} />
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <section class="now-summary" aria-labelledby="sidebar-now">
      <h2 id="sidebar-now">NOW</h2>
      <ul>
        {status.map((item) => <li><span class:list={['status-dot', { 'is-current': item.current }]}></span><span>{item.text}</span></li>)}
      </ul>
    </section>
  </div>

  <footer>
    <div class="socials" aria-label={text.externalLinks}>
      <a href={`mailto:${SITE.contact.email}`} aria-label={text.email}><Icon name="mail" /></a>
      <a href={SITE.contact.githubUrl} aria-label="GitHub"><Icon name="github" /></a>
      <a href={SITE.contact.extraLink.url} aria-label={SITE.contact.extraLink.label}><Icon name="x" /></a>
      <a href={rssHref} aria-label={text.rss}><Icon name="rss" /></a>
    </div>
    <p>{text.updated} <time datetime={SITE.now.updatedAt}>{DISPLAY_UPDATED_AT}</time></p>
  </footer>
</aside>

<style>
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 20;
    display: flex;
    width: var(--sidebar-width);
    flex-direction: column;
    justify-content: space-between;
    overflow-y: auto;
    padding: 2.6rem 2rem 2rem;
    border-right: 1px solid var(--color-line);
    background: var(--color-sidebar);
  }

  .identity-block {
    position: relative;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-line);
  }

  .identity { display: block; }

  .identity strong {
    display: block;
    padding-right: 4.75rem;
    margin-bottom: 0.65rem;
    font-family: var(--font-display);
    font-size: 2.7rem;
    font-stretch: condensed;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .identity span {
    color: var(--color-body);
    font-size: 0.78rem;
  }

  .language-switch {
    position: absolute;
    top: 0.15rem;
    right: 0;
    display: flex;
    gap: 0.4rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1;
  }

  .language-switch a:hover { color: var(--color-accent); }
  .language-switch span[aria-current="true"] { color: var(--color-ink); }
  .language-switch i { color: var(--color-soft); font-style: normal; }

  .primary-nav {
    display: grid;
    gap: 0.25rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .nav-link {
    position: relative;
    display: flex;
    min-height: 2.8rem;
    align-items: center;
    gap: 0.8rem;
    padding: 0.5rem 0;
    font-size: 0.96rem;
    transition: color 160ms ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 0;
    width: 2px;
    height: 1.5rem;
    background: transparent;
    transform: translateY(-50%);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent);
  }

  .nav-link.active::after {
    background: var(--color-accent);
  }

  .now-summary {
    padding-top: 1.6rem;
  }

  .now-summary h2 {
    margin: 0 0 1rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  .now-summary ul {
    display: grid;
    gap: 0.7rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .now-summary li {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    color: var(--color-muted);
    font-size: 0.77rem;
    line-height: 1.5;
  }

  footer {
    padding-top: 2rem;
  }

  .socials {
    display: flex;
    gap: 1.15rem;
    margin-bottom: 1.25rem;
  }

  .socials a {
    color: var(--color-body);
  }

  .socials a:hover {
    color: var(--color-accent);
  }

  footer p {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  @media (max-width: 900px) {
    .sidebar {
      display: none;
    }
  }
</style>
