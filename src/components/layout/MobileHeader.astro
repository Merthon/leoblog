---
import Icon from '../ui/Icon.astro';
import { CURRENT_STATUS, CURRENT_STATUS_EN, DISPLAY_UPDATED_AT, SITE } from '../../config/site';
import { layoutText, navigation, type SiteLocale } from '../../i18n/ui';

interface Props {
  active: 'index' | 'writing' | 'reading' | 'projects' | 'now';
  locale?: SiteLocale;
  languageHref: string;
}

const { active, locale = 'zh-CN', languageHref } = Astro.props;
const isEnglish = locale === 'en';
const nav = navigation[locale];
const text = layoutText[locale];
const status = isEnglish ? CURRENT_STATUS_EN : CURRENT_STATUS;
const homeHref = isEnglish ? '/en/' : '/';
const rssHref = isEnglish ? '/en/rss.xml' : '/rss.xml';
---

<header class="mobile-header">
  <a class="logo" href={homeHref}>{SITE.logoText}</a>
  <div class="header-actions">
    <a class="mobile-language" href={languageHref} hreflang={isEnglish ? 'zh-CN' : 'en'}>{isEnglish ? '中文' : 'EN'}</a>
    <button type="button" data-menu-open aria-label={text.openMenu}>MENU</button>
  </div>
</header>

<dialog class="mobile-menu" data-mobile-menu>
  <div class="menu-header">
    <a class="logo" href={homeHref}>{SITE.logoText}</a>
    <button type="button" data-menu-close aria-label={text.closeMenu}>CLOSE</button>
  </div>

  <nav aria-label={text.mobileNavLabel}>
    {nav.map((item) => (
      <a class:list={['menu-link', { active: active === item.id }]} href={item.href} aria-current={active === item.id ? 'page' : undefined}>
        <Icon name={item.icon} size={26} />
        <span>{item.label}</span>
      </a>
    ))}
  </nav>

  <section class="menu-now">
    <h2>NOW</h2>
    {status.map((item) => <p><span class:list={['status-dot', { 'is-current': item.current }]}></span>{item.text}</p>)}
  </section>

  <footer>
    <div><a href={`mailto:${SITE.contact.email}`}>Email</a><a href={SITE.contact.githubUrl}>GitHub</a><a href={SITE.contact.extraLink.url}>{SITE.contact.extraLink.label}</a><a href={rssHref}>RSS</a></div>
    <p>{text.updated} {DISPLAY_UPDATED_AT}</p>
  </footer>
</dialog>

<script>
  const dialog = document.querySelector('[data-mobile-menu]');
  const openButton = document.querySelector('[data-menu-open]');
  const closeButton = document.querySelector('[data-menu-close]');

  if (dialog instanceof HTMLDialogElement && openButton instanceof HTMLButtonElement && closeButton instanceof HTMLButtonElement) {
    openButton.addEventListener('click', () => {
      dialog.showModal();
      document.body.classList.add('menu-open');
    });

    const closeMenu = () => {
      dialog.close();
      document.body.classList.remove('menu-open');
      openButton.focus();
    };

    closeButton.addEventListener('click', closeMenu);
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeMenu();
    });
  }
</script>

<style>
  .mobile-header,
  .mobile-menu {
    display: none;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  button {
    padding: 0.75rem 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    cursor: pointer;
  }

  .header-actions { display: flex; align-items: center; gap: 1.25rem; }
  .mobile-language { color: var(--color-muted); font-family: var(--font-mono); font-size: 0.76rem; }
  .mobile-language:hover { color: var(--color-accent); }

  @media (max-width: 900px) {
    .mobile-header {
      position: fixed;
      inset: 0 0 auto;
      z-index: 30;
      display: flex;
      height: 4.5rem;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.25rem;
      border-bottom: 1px solid var(--color-line);
      background: var(--color-paper);
    }

    .mobile-menu[open] {
      position: fixed;
      inset: 0;
      z-index: 40;
      display: grid;
      width: 100%;
      max-width: none;
      height: 100%;
      max-height: none;
      grid-template-rows: auto 1fr auto auto;
      padding: 0;
      border: 0;
      background: var(--color-sidebar);
    }

    .mobile-menu::backdrop {
      background: transparent;
    }

    .menu-header {
      display: flex;
      height: 4.5rem;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.25rem;
      border-bottom: 1px solid var(--color-line);
    }

    nav {
      padding: 1.25rem;
    }

    .menu-link {
      position: relative;
      display: flex;
      min-height: 5rem;
      align-items: center;
      gap: 1rem;
      border-bottom: 1px solid var(--color-line);
      font-size: 1.65rem;
      font-weight: 650;
    }

    .menu-link.active {
      color: var(--color-accent);
    }

    .menu-link.active::after {
      content: "";
      position: absolute;
      bottom: 0.85rem;
      left: 0;
      width: 2rem;
      height: 2px;
      background: var(--color-accent);
    }

    .menu-now {
      padding: 1.25rem;
      border-top: 1px solid var(--color-line);
    }

    .menu-now h2 {
      margin: 0 0 1rem;
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.12em;
    }

    .menu-now p {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin: 0.55rem 0;
      color: var(--color-muted);
      font-size: 0.9rem;
    }

    footer {
      padding: 1.25rem;
      border-top: 1px solid var(--color-line);
      font-family: var(--font-mono);
    }

    footer div {
      display: flex;
      justify-content: space-between;
    }

    footer p {
      margin: 1rem 0 0;
      color: var(--color-muted);
      font-size: 0.75rem;
    }
  }
</style>
